{
  "name": "my-workspace",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "prepare": "husky",
    "start": "node ./scripts/start.mjs",
    "dev:web": "node ./scripts/start.mjs web dev",
    "dev:miniapp": "node ./scripts/start.mjs miniapp dev:weapp",
    "dev:mobile": "node ./scripts/start.mjs mobile start",
    "build:web": "pnpm --dir apps/web build",
    "build:miniapp": "pnpm --dir apps/miniapp build:weapp",
    "build:app:ios": "pnpm --dir apps/mobile build:ios",
    "build:app:android": "pnpm --dir apps/mobile build:android",
    "build:app:ios:local": "pnpm --dir apps/mobile build:ios:local",
    "build:app:android:local": "pnpm --dir apps/mobile build:android:local",
    "build": "node ./scripts/build.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.25.0",
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "node scripts/typecheck-staged.mjs"
    ],
    "*.{js,mjs,json,md,scss,css,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@inquirer/prompts": "^8.7.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  }
}
